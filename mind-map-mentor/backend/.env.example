# PostgreSQL connection string (used by Prisma and the app)
# Matches docker-compose.yml: user/password/mindmapdb on localhost:5432
DATABASE_URL=postgresql://user:password@localhost:5432/mindmapdb

# Secret key for signing JWT tokens (generate a strong random key for production)
# Use: openssl rand -hex 32
SECRET_KEY=your_secret_key_here

# JWT algorithm and access-token lifetime (minutes)
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Pinecone
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=mentra

# OpenAI (embeddings + chat)
OPENAI_API_KEY=your_openai_api_key

# File storage directory
FILE_STORAGE_PATH=./storage

# Similarity thresholds for automatic edge creation
SIMILARITY_THRESHOLD=0.5
SIMILARITY_THRESHOLD_SUMMARY=0.5
SIMILARITY_THRESHOLD_CONTENT=0.5

# Server port
PORT=8000
