# PostgreSQL connection string (used by Prisma and the app)
# Matches docker-compose.yml: user/password/mindmapdb on localhost:5432
DATABASE_URL=postgresql://user:password@localhost:5432/mindmapdb

# Secret key for signing JWT tokens (generate a strong random key for production)
# Use: openssl rand -hex 32
SECRET_KEY=your_secret_key_here

# JWT algorithm and access-token lifetime (minutes)
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Pinecone
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_ENVIRONMENT=us-east-1
PINECONE_CLOUD=aws
PINECONE_INDEX_NAME=mentra

# Google AI (embeddings + chat)
GOOGLE_API_KEY=your_google_api_key

# Optional model overrides (defaults shown)
# GOOGLE_EMBEDDING_MODEL=gemini-embedding-001
# GOOGLE_CHAT_MODEL=gemini-3.6-flash

# File storage directory
FILE_STORAGE_PATH=./storage

# Similarity thresholds
# SIMILARITY_THRESHOLD         floor for the "Weakly Related" edge label
# SIMILARITY_THRESHOLD_SUMMARY minimum score to auto-link two notes
# SIMILARITY_THRESHOLD_CONTENT minimum score for a chunk to be used as RAG
#                              context or returned by semantic search
SIMILARITY_THRESHOLD=0.5
SIMILARITY_THRESHOLD_SUMMARY=0.5
SIMILARITY_THRESHOLD_CONTENT=0.5

# Server port
PORT=8000

# Comma-separated origins allowed to call the API (the Next.js dev server)
CORS_ORIGINS=http://localhost:3000
