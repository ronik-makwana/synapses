# --- Node.js / TypeScript ---
node_modules/
dist/
*.tsbuildinfo

# Logs
*.log
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Prisma ---
# Migrations ARE committed; the generated client is a build artifact and is
# recreated by `prisma generate` (wired to npm postinstall).
generated/

# --- Environment / secrets ---
.env
.env.*
!.env.example

# --- Uploaded files ---
# User uploads live here at runtime; never version them.
storage/*
!storage/.gitkeep

# --- Test / coverage output ---
coverage/
.nyc_output/
.vitest/

# --- Editors ---
.idea/
.vscode/
*.swp
*.swo

# --- OS ---
.DS_Store
._*
Thumbs.db
